---
import Layout from '../layouts/Layout.astro';
import GameListing from '../components/GameListing.astro';
import PageHero from '../components/PageHero.astro';
import { getDatabase } from '../lib/db';
import { getPaginatedGames } from '../lib/games';

export const prerender = true;

const pagination = await getPaginatedGames(getDatabase(), 1, 6);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <GameListing pagination={pagination} />
  </div>
</Layout>
